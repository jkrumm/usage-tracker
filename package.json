{
  "name": "usage-tracker",
  "version": "0.1.0",
  "description": "Token/cost telemetry across every AI tool, ingested into the Postgres usage schema",
  "private": true,
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "usage-tracker": "src/cli.ts"
  },
  "scripts": {
    "ingest": "bun run src/cli.ts ingest",
    "stats": "bun run src/cli.ts stats",
    "sources": "bun run src/cli.ts sources",
    "billing-audit": "bun run src/cli.ts billing-audit",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
